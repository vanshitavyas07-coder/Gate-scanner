<!DOCTYPE html>
<html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Gate Scanner</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html5-qrcode/2.3.8/html5-qrcode.min.js"></script>
<style>
*{box-sizing:border-box}body{margin:0;font-family:'Segoe UI',Roboto,Arial,sans-serif;background:#0b1020;color:#e8ecf7;min-height:100vh}
header{display:flex;justify-content:space-between;padding:14px 16px;background:#121a33;border-bottom:1px solid #223;font-weight:700}
.wrap{max-width:440px;margin:0 auto;padding:14px}
.seg{display:flex;background:#121a33;border-radius:14px;padding:5px;margin-bottom:14px}
.seg button{flex:1;padding:14px;border:0;border-radius:10px;background:none;color:#8b97b8;font-size:16px;font-weight:700}
.seg button.on.in{background:#16a34a;color:#fff}.seg button.on.out{background:#ea580c;color:#fff}
.cam{position:relative;border-radius:18px;overflow:hidden;background:#000;min-height:260px}
#reader video{width:100%!important}
#res{display:none;position:absolute;inset:0;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:20px;z-index:5}
#res .ic{font-size:64px}#res .t{font-size:22px;font-weight:700;margin-top:6px}
.ok{background:#16a34a}.bad{background:#dc2626}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:14px 0}
.stat{background:#121a33;border-radius:14px;padding:12px;text-align:center}.stat b{display:block;font-size:26px}.stat span{font-size:11px;color:#8b97b8;text-transform:uppercase}
.man{display:flex;gap:8px}.man input{flex:1;padding:13px;border-radius:12px;border:1px solid #2a3560;background:#121a33;color:#fff;font-size:15px}
.man button{padding:0 20px;border:0;border-radius:12px;background:#2563eb;color:#fff;font-weight:700}
#msg{color:#fbbf24;font-size:14px;padding:8px 2px}
</style></head><body>
<header><span>🎟 Gate Scanner</span><span id="modeTxt"></span></header>
<div class="wrap">
 <div class="seg"><button id="bi" onclick="setMode('entry')">⬇ ENTRY</button><button id="bo" onclick="setMode('exit')">⬆ EXIT</button></div>
 <div class="cam"><div id="reader"></div><div id="res"><div class="ic"></div><div class="t"></div></div></div>
 <div id="msg"></div>
 <div class="stats"><div class="stat"><b id="sr">-</b><span>Registered</span></div><div class="stat"><b id="si">-</b><span>Inside</span></div><div class="stat"><b id="se">-</b><span>Exited</span></div></div>
 <div class="man"><input id="m" placeholder="Type ID or use a USB QR scanner" onkeydown="if(event.key==='Enter')go(this.value)"><button onclick="go(m.value)">GO</button></div>
</div>
<script>
/* PASTE your Apps Script Web app /exec link between the quotes (or leave empty and the page will ask once). */
const API_URL = 'https://script.google.com/a/macros/indianjeweller.in/s/AKfycbwUFuhPP-crOiKBWyuz9yVpevSeeE6gRDmA7LP_t4bXzLWnG8usfP47yb3quW5Cppwxmg/exec';
let API = API_URL || localStorage.getItem('api') || '';
if (!/^https:\/\/script\.google\.com\//.test(API)) { API = (prompt('Paste the Web app /exec link:') || '').trim(); localStorage.setItem('api', API); }
let mode = location.hash === '#exit' ? 'exit' : 'entry', busy = false, ctx;
function setMode(x){mode=x;bi.className=x=='entry'?'on in':'';bo.className=x=='exit'?'on out':'';modeTxt.textContent=x.toUpperCase();location.hash=x}
function beep(ok){try{ctx=ctx||new (window.AudioContext||window.webkitAudioContext)();const o=ctx.createOscillator(),g=ctx.createGain();o.connect(g);g.connect(ctx.destination);o.frequency.value=ok?880:220;g.gain.value=.15;o.start();o.stop(ctx.currentTime+(ok?.15:.4))}catch(e){}if(navigator.vibrate)navigator.vibrate(ok?80:[150,80,150])}
function flash(ok,t){res.className=ok?'ok':'bad';res.style.display='flex';res.querySelector('.ic').textContent=ok?'✔':'✖';res.querySelector('.t').textContent=t;setTimeout(()=>{res.style.display='none';busy=false},2200)}
function go(text){
 let id=String(text||'').trim();const mm=/SHOW-\d+/i.exec(id);if(mm)id=mm[0].toUpperCase();
 if(busy||!id)return;busy=true;
 fetch(API+'?api=scan&mode='+mode+'&id='+encodeURIComponent(id)).then(r=>r.json())
  .then(r=>{beep(r.ok);flash(r.ok,r.message);m.value='';stats()})
  .catch(e=>{beep(false);flash(false,'Network error. Try again.')});
}
function stats(){fetch(API+'?api=stats').then(r=>r.json()).then(s=>{sr.textContent=s.registered;si.textContent=s.inside;se.textContent=s.exited}).catch(()=>{})}
setMode(mode);stats();setInterval(stats,10000);
new Html5Qrcode('reader').start({facingMode:'environment'},{fps:12,qrbox:230},go)
 .catch(e=>{msg.textContent='Camera could not start: '+(e&&e.message||e)+'. Allow camera for this site and reload, or type the ID below.'});
</script></body></html>
